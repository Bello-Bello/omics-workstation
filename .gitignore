# Generated pipeline outputs / large data — regenerate, don't commit
pipelines/*/results/
pipelines/*/logs/
pipelines/*/resources/reads/
pipelines/*/resources/reference/
pipelines/*/resources/salmon_index/
pipelines/*/resources/perturbation/
# pertpy caches downloads to a relative ./data/ dir regardless of requested output path
pipelines/*/data/
pipelines/*/.snakemake/
pipelines/*/work/
pipelines/*/.nextflow/
pipelines/*/.nextflow.log*

# Common junk
.Rhistory
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
