params {
    // ---- Data source -------------------------------------------------
    // QIIME2's public Atacama Desert soil dataset (Neilson et al. 2017):
    // 16S V4 amplicons from vegetated and barren soils along two transects.
    // Chosen over a synthetic mock community because the interesting
    // property here is real soil's sparsity — most taxa absent from most
    // samples — which is exactly what the compositional machinery exists
    // to handle.
    subsample        = "10p"   // "1p", "10p" or "" (full) as hosted upstream
    data_base        = "https://data.qiime2.org/2024.10/tutorials/atacama-soils"
    metadata_url     = "https://data.qiime2.org/2024.10/tutorials/atacama-soils/sample_metadata.tsv"

    // Greengenes 13_8 99% OTUs trained on the 515F/806R region — the same
    // primer pair this dataset was sequenced with. A classifier trained on
    // the wrong region will happily return confident nonsense, so the
    // region match matters more than the reference database choice.
    // The sklearn-1.4.2 path must match the scikit-learn in the container
    // below; a mismatch fails at load time with an opaque pickle error.
    classifier_url   = "https://data.qiime2.org/classifiers/sklearn-1.4.2/greengenes/gg-13-8-99-515-806-nb-classifier.qza"

    // ---- DADA2 denoising ---------------------------------------------
    // trim_left removes the primer; trunc_len cuts where the quality
    // profile falls off. These are the values the upstream tutorial
    // established for this run — see README.md before changing them, since
    // trunc_len_f + trunc_len_r must leave enough overlap to merge pairs.
    trim_left_f      = 13
    trim_left_r      = 13
    trunc_len_f      = 150
    trunc_len_r      = 150

    // ---- Compositional analysis --------------------------------------
    group_column     = "vegetation"
    group_a          = "yes"
    group_b          = "no"
    rank             = "genus"
    min_prevalence   = 0.15
    min_total_count  = 25
    min_depth        = 1000
    permutations     = 999
    monte_carlo      = 128
    alpha            = 0.05
    seed             = 0

    outdir           = "results"
    qiime_container  = "quay.io/qiime2/amplicon:2024.10"
}

// The QIIME2 steps run in the pinned container; the analysis step runs in
// a small conda env (envs/compositional.yaml). Both are enabled so each
// process picks up whichever it declares — see modules/.
docker.enabled = true
conda.enabled  = true

// QIIME2 writes caches and temp files as the invoking user. Without the
// uid/gid mapping, container-created files land on the host owned by root;
// without a writable HOME, matplotlib and numba fail trying to create
// cache directories under a non-existent home.
docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp -e TMPDIR=/tmp -e MPLCONFIGDIR=/tmp -e NUMBA_CACHE_DIR=/tmp -e XDG_CACHE_HOME=/tmp'

process {
    cpus = 4
    errorStrategy = 'terminate'

    withName: DENOISE_DADA2 {
        // DADA2 learns its error model per run and holds the dereplicated
        // reads in memory; this is the one step that needs real headroom.
        memory = '8.GB'
    }
}

profiles {
    // Smaller, faster settings for CI and for a first local run.
    // Fewer permutations and Monte-Carlo draws, same real data. The 1%
    // subsample the upstream tutorial also hosts was tried first and
    // rejected: at ~230 reads per sample the table is 82% zeros after
    // filtering, so the CLR values are mostly imputation and the result is
    // a test that passes without testing anything real. Cutting the
    // statistical work is honest; cutting the data until it stops being
    // data is not.
    test {
        params.permutations = 499
        params.monte_carlo  = 32
    }
}

timeline.enabled = true
timeline.file    = "${params.outdir}/pipeline_info/timeline.html"
report.enabled   = true
report.file      = "${params.outdir}/pipeline_info/report.html"
report.overwrite = true
timeline.overwrite = true
