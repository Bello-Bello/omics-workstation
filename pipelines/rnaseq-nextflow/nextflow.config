params {
    samples             = "config/samples.tsv"
    transcriptome_fasta = "resources/reference/transcriptome.fa"
    gtf                 = "resources/reference/annotation.gtf"
    outdir              = "results"
}

// Default: conda envs, exactly as before — plain `nextflow run main.nf`
// keeps working unchanged. `-profile docker` opts into containers instead.
conda.enabled = true

process {
    cpus = 4
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
    }
}
