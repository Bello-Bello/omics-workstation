params {
    samples            = "config/samples.tsv"
    genome_fasta       = "resources/reference/genome.chr19.fa"
    gtf                = "resources/reference/annotation.chr19.gtf"
    barcode_whitelist  = "resources/reference/barcode_whitelist_v2.txt"
    outdir             = "results"

    // perturbation.nf params (see that file) — sciplex2 column names by
    // default; a different perturbation dataset only needs these changed,
    // not the pipeline code itself.
    dataset            = "sciplex2"
    perturbation_col   = "perturbation"
    dose_col           = "dose_value"
    control_label      = "control"
    mt_prefix          = "MT-"
    min_genes          = 200
    max_pct_mt         = 20.0
    leiden_resolution  = 0.5
}

conda.enabled = true

process {
    cpus = 4
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled = false
    }
}
